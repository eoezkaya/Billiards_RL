# Configuration file for train.py
# Specify environment and training parameters

# Ball placement area boundaries
red_x_range_min = 0.1
red_x_range_max = 0.9
red_y_range_min = 0.1
red_y_range_max = 1.95
white_x_range_min = 0.1
white_x_range_max = 0.9
white_y_range_min = 0.1
white_y_range_max = 1.95

# Pocket configuration
train_corner_pocket = False
train_center_pocket = True

# RL Algorithm (PPO or SAC)
method = PPO

# Output file name (without extension, .txt will be added)
out_file = negative_success_ratio

# Model output path (directory where the final model will be saved)
# Use a descriptive name. The model will be saved as final_model_path/method_billiards_final.zip
final_model_path = ./models/ppo_billiards/

# Training parameters
fixed_difficulty = 30
total_timesteps = 2000000

# Evaluation parameters
eval_episodes = 1000
inference_difficulty = 60.0
